{
  "name": "@zeroqs/eslint",
  "type": "module",
  "version": "1.2.5",
  "description": "eslint configs",
  "author": {
    "name": "zeroqs",
    "url": "https://github.com/zeroqs"
  },
  "license": "MIT",
  "homepage": "https://github.com/zeroqs/core",
  "repository": {
    "url": "https://github.com/zeroqs/core"
  },
  "bugs": {
    "url": "https://github.com/zeroqs/core/issues"
  },
  "keywords": [
    "eslint",
    "react",
    "node"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.d.ts",
    "index.js"
  ],
  "scripts": {
    "format": "prettier --write \"*.js\"",
    "lint": "eslint . --fix",
    "lint-inspector": "npx @eslint/config-inspector"
  },
  "peerDependencies": {
    "eslint": "^9.9.0"
  },
  "dependencies": {
    "@antfu/eslint-config": "4.10.1",
    "@eslint-react/eslint-plugin": "1.34.1",
    "@next/eslint-plugin-next": "15.2.2",
    "@vue/compiler-sfc": "3.5.13",
    "eslint": "9.22.0",
    "eslint-plugin-effector": "^0.15.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.4",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.19"
  },
  "devDependencies": {
    "@zeroqs/prettier": "*"
  }
}
