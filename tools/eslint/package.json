{
  "name": "@zeroqs/eslint",
  "type": "module",
  "version": "1.2.6",
  "description": "eslint configs",
  "author": {
    "name": "zeroqs",
    "url": "https://github.com/zeroqs"
  },
  "license": "MIT",
  "homepage": "https://github.com/zeroqs/core",
  "repository": {
    "url": "https://github.com/zeroqs/core"
  },
  "bugs": {
    "url": "https://github.com/zeroqs/core/issues"
  },
  "keywords": [
    "eslint",
    "react",
    "node"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.d.ts",
    "index.js"
  ],
  "scripts": {
    "format": "prettier --write \"*.js\"",
    "lint": "eslint . --fix",
    "lint-inspector": "npx @eslint/config-inspector"
  },
  "peerDependencies": {
    "eslint": "^9.9.0"
  },
  "dependencies": {
    "@antfu/eslint-config": "6.2.0",
    "@eslint/compat": "2.0.0",
    "@eslint-react/eslint-plugin": "2.3.9",
    "@next/eslint-plugin-next": "16.0.4",
    "@vue/compiler-sfc": "3.5.25",
    "eslint-plugin-effector": "0.16.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24"
  },
  "devDependencies": {
    "@zeroqs/prettier": "*"
  }
}
